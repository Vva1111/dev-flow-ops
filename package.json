{
  "name": "dev-flow-ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev-finance": "turbo run dev --filter=@devflowops/finance-web --filter=@devflowops/finance-server",
    "dev-finance-server": "pnpm --filter @devflowops/finance-server dev",
    "dev-portal": "pnpm --filter @devflowops/platform-web dev",
    "build": "turbo run build",
    "lint": "pnpm lint:docs && turbo run lint",
    "lint:docs": "node scripts/check-doc-language.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7"
  }
}
